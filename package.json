{  "name": "dsh-chat-plus",  "version": "0.9.0",  "description": "DSH 对话体验增强套件（零 DSH 源码改动，纯插件注入）。回合呈现：思考 / 工具调用聚合 chip（实时走秒 + 分步跟随滚动）+ 步骤卡 / 总结卡（回合收口才出现）+ 共享活动抽屉（思考语义分组 + 工具调用树）。正文增强：proto-tabs 可交互卡片 + diagram 流程图围栏（JSON 转 SVG）+ 生图画廊 + 重试行影子。界面与工具：会话头部视图标签上移右上角 + 桌面壳窗口控制留位与主题同步 + 对话截图（常驻无头浏览器渲染 markdown/shiki/mermaid，可内嵌本地 HTML）+ download 下载工具（wire 工具 + 实时进度条/速度/ETA）。动效：思考两行步进跟随、流式新文字淡入、忙碌标签微光、展开收起过渡。另有可选的 KR 对话双栏执行大盘（由 KR_CHAT_ENABLED 总开关门控，默认关闭）。",  "keywords": [    "dsh",    "dsh-plugin",    "deepseek-harness",    "reasoning",    "tool-summary",    "activity-drawer",    "flow-card",    "screenshot",    "download",    "progress",    "proto-tabs",    "diagram",    "chat-plus"  ],  "repository": {    "type": "git",    "url": "git+https://github.com/Kr-ATG/dsh-chat-plus.git"  },  "type": "module",  "main": "./lib/index.js",  "exports": {    ".": "./lib/index.js",    "./client": "./lib/client.js",    "./cordis.patch.yml": "./cordis.patch.yml",    "./package.json": "./package.json"  },  "files": [    "lib",    "assets",    "scripts",    "build.mjs",    "cordis.patch.yml",    "README.md"  ],  "dsh": {    "bundle": {      "patch": "./cordis.patch.yml"    },    "client": {      "platform": "web",      "inject": [        "@deepseek-ai/dsh-client-runtime",        "@deepseek-ai/dsh-client-ui-slots",        "@deepseek-ai/dsh-client-ui-conversation",        "@deepseek-ai/dsh-client-ui-primitives",        "@deepseek-ai/dsh-client-ui-tool"      ]    }  },  "devDependencies": {    "esbuild": "^0.25.0"  },  "scripts": {    "build": "node build.mjs",    "typecheck": "tsc -p tsconfig.json --noEmit",    "smoke": "node scripts/smoke-client.mjs && node scripts/smoke-host.mjs",    "smoke:client": "node scripts/smoke-client.mjs",    "smoke:host": "node scripts/smoke-host.mjs"  },  "engines": {    "node": ">=22"  },  "license": "MIT",  "dependencies": {    "markdown-it": "^15.0.1",    "markdown-it-emoji": "^3.1.0",    "markdown-it-task-lists": "^2.1.1",    "shiki": "^4.4.3"  }}