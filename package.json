{  "name": "dsh-chat-flow",  "version": "0.8.51",  "description": "DSH 对话流增强插件（自 dsh-webui 拆出，零 DSH 源码改动、纯插件注入）。回合呈现：思考 chip（实时时长 + 分步跟随滚动）+ 工具调用聚合 chip + 对话流卡片（步骤卡/总结卡，回合结束后才出现）+ 共享活动抽屉（思考语义分组 + 工具调用树）。动效（移植自 dsh-better-display）：思考两行步进跟随 + 流式新文字淡入 + 忙碌标签微光 + 展开收起过渡。正文增强：proto-tabs 可交互卡片（pill/expand/glow）+ diagram 流程图围栏（JSON 转 SVG）。界面与工具：会话头部对话/轨迹标签上移到右上角 + 壳内窗口控制留位（与壳 dsh:shell-chrome 能力握手后挂 dsh-in-shell，header 右簇左移 100px 让给壳的自绘最小化/最大化/关闭，主题属性变更 postMessage dsh:theme 给壳同步按钮配色） + 对话截图（常驻无头浏览器渲染 markdown/shiki/mermaid 真图，可内嵌本地 HTML）+ download 下载工具（host 注册 wire 工具与进度路由，client keyed toolview 实时进度条/速度/ETA）。",  "keywords": [    "dsh",    "dsh-plugin",    "deepseek-harness",    "reasoning",    "tool-summary",    "activity-drawer",    "flow-card",    "screenshot",    "download",    "progress",    "proto-tabs",    "diagram",    "chat-flow"  ],  "repository": {    "type": "git",    "url": "git+https://github.com/Kr-ATG/dsh-chat-flow.git"  },  "type": "module",  "main": "./lib/index.js",  "exports": {    ".": "./lib/index.js",    "./client": "./lib/client.js",    "./cordis.patch.yml": "./cordis.patch.yml",    "./package.json": "./package.json"  },  "files": [    "lib",    "assets",    "scripts",    "build.mjs",    "cordis.patch.yml",    "README.md"  ],  "dsh": {    "bundle": {      "patch": "./cordis.patch.yml"    },    "client": {      "platform": "web",      "inject": [        "@deepseek-ai/dsh-client-runtime",        "@deepseek-ai/dsh-client-ui-slots",        "@deepseek-ai/dsh-client-ui-conversation",        "@deepseek-ai/dsh-client-ui-primitives",        "@deepseek-ai/dsh-client-ui-tool"      ]    }  },  "devDependencies": {    "esbuild": "^0.25.0"  },  "scripts": {    "build": "node build.mjs",    "typecheck": "tsc -p tsconfig.json --noEmit",    "smoke": "node scripts/smoke-client.mjs && node scripts/smoke-host.mjs",    "smoke:client": "node scripts/smoke-client.mjs",    "smoke:host": "node scripts/smoke-host.mjs"  },  "engines": {    "node": ">=22"  },  "license": "MIT",  "dependencies": {    "markdown-it": "^15.0.1",    "markdown-it-emoji": "^3.1.0",    "markdown-it-task-lists": "^2.1.1",    "shiki": "^4.4.3"  }}